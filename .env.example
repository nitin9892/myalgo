# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Cron Secret (protects /api/cron/trade-cycle)
CRON_SECRET=your-random-cron-secret-key

# Dhan API Credentials (can also be saved in Supabase)
DHAN_CLIENT_ID=your-dhan-client-id
DHAN_ACCESS_TOKEN=your-dhan-access-token

# Delta Exchange Credentials (can also be saved in Supabase)
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret

# MetaTrader Webhook / Bridge Token
MT_BRIDGE_SECRET=your-metatrader-bridge-secret
